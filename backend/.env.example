# Environment Variables Template
# Copy this file to .env and add your actual API keys
# NEVER commit the .env file to git!

# API Keys (optional - not used with local-only mode)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Local model configuration
USE_LOCAL_MODEL=1
# For Render free tier (512MB RAM), use flan-t5-small (80MB)
# Options: google/flan-t5-small (80MB), google/flan-t5-base (250MB), google/flan-t5-large (780MB)
LOCAL_MODEL_NAME=google/flan-t5-small

# Server configuration
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
